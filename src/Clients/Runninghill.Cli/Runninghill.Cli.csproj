<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Runninghill.Contracts/Runninghill.Contracts.csproj" />
    <!-- Share only display messages, without adding a wrapper or another assembly. -->
    <Compile Include="../Shared/ClientMessages.cs" Link="ClientMessages.cs" />
  </ItemGroup>
</Project>
