<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <ProjectReference Include="../../Runninghill.Contracts/Runninghill.Contracts.csproj" />
    <!-- Share error descriptions, without adding a request wrapper or another assembly. -->
    <Compile Include="../Shared/ClientMessages.cs" Link="ClientMessages.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Shared/OperationLog.cs" Link="OperationLog.cs" />
  </ItemGroup>
</Project>
