<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <!-- Photino/Blazor discovers components at runtime; preserve their metadata. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <ProjectReference Include="../../Runninghill.Contracts/Runninghill.Contracts.csproj" />
    <Compile Include="../Shared/AppThemes.cs" Link="AppThemes.cs" />
    <Compile Include="../Shared/ClientMessages.cs" Link="ClientMessages.cs" />
    <Compile Include="../../Shared/RecentLogStore.cs" Link="RecentLogStore.cs" />
    <EmbeddedResource Include="../../../themes/*.json" LogicalName="Runninghill.Themes.%(Filename).json" />
    <EmbeddedResource Include="../../../themes/*_icon.webp" LogicalName="Runninghill.Themes.%(Filename).webp" />
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Runninghill.Web/wwwroot/appearance.js" Link="wwwroot/appearance.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Runninghill.Web/wwwroot/theme-defaults.css" Link="wwwroot/theme-defaults.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
