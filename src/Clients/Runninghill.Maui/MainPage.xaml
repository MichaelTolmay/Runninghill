<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Runninghill.Maui.MainPage" Title="Word collection" Shell.NavBarIsVisible="False" SafeAreaEdges="All" BackgroundColor="#F0F2F5" SizeChanged="OnLayoutChanged">
    <ContentPage.Resources>
        <!-- The same colors, spacing and type scale as the web design, using native controls. -->
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="#2D3748" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="{OnPlatform WinUI='Segoe UI', Default='OpenSansRegular'}" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{OnPlatform WinUI='Segoe UI', Default='OpenSansSemibold'}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="BackgroundColor" Value="#2868B1" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MinimumHeightRequest" Value="{OnPlatform WinUI=44, Default=48}" />
            <Setter Property="MinimumWidthRequest" Value="{OnPlatform WinUI=44, Default=48}" />
            <!-- Keep disabled actions visibly different, just like the website. -->
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.48" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}" />
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="#245B99" />
            <Setter Property="BorderColor" Value="#BDCFE4" />
            <Setter Property="BorderWidth" Value="1" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="FontFamily" Value="{OnPlatform WinUI='Segoe UI', Default='OpenSansRegular'}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="#2D3748" />
            <Setter Property="PlaceholderColor" Value="#657185" />
            <Setter Property="MinimumHeightRequest" Value="{OnPlatform WinUI=44, Default=48}" />
        </Style>
        <Style TargetType="Picker">
            <Setter Property="FontFamily" Value="{OnPlatform WinUI='Segoe UI', Default='OpenSansRegular'}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="#2D3748" />
            <Setter Property="MinimumHeightRequest" Value="{OnPlatform WinUI=44, Default=48}" />
        </Style>
        <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#2868B1" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="BackgroundColor" Value="#B42337" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="#E2E8F0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Padding" Value="24" />
        </Style>
        <Style x:Key="Heading" TargetType="Label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#1A1A2E" />
        </Style>
        <Style x:Key="Eyebrow" TargetType="Label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="CharacterSpacing" Value="1.6" />
            <Setter Property="TextColor" Value="#5B6C85" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="Muted" TargetType="Label">
            <Setter Property="TextColor" Value="#5E6979" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </ContentPage.Resources>
    <!-- Keep section shortcuts reachable even after scrolling through a full page of words. -->
    <Grid RowDefinitions="*,Auto">
        <ScrollView x:Name="PageScroll">
            <VerticalStackLayout x:Name="Workspace" Padding="40,24" Spacing="24" MaximumWidthRequest="1440" HorizontalOptions="Center">
                <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                    <Border BackgroundColor="#2868B1" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="44">
                        <Label Text="W" TextColor="White" FontSize="25" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Runninghill" FontSize="20" FontAttributes="Bold" />
                        <Label Text="WORD COLLECTION" FontSize="10" CharacterSpacing="1.8" />
                    </VerticalStackLayout>
                    <Border Grid.Column="2" BackgroundColor="#E9EFF8" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="10,6" MaximumWidthRequest="125" VerticalOptions="Center">
                        <Label x:Name="ConnectionState" Text="Not connected" FontSize="12" TextColor="#315C8C" HorizontalTextAlignment="Center" />
                    </Border>
                </Grid>
                <BoxView HeightRequest="1" Color="#DCE2E9" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" Margin="0,8">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="A LITTLE LANGUAGE, A LOT OF POSSIBILITY" Style="{StaticResource Eyebrow}" />
                        <Label x:Name="HeroTitle" Text="Your words. New possibilities." FontSize="32" FontAttributes="Bold" TextColor="#1A1A2E" SemanticProperties.HeadingLevel="Level1" />
                        <Label Text="Collect words by type, then bring them together in a sentence." Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                    <Button x:Name="IntroSentenceButton" Grid.Column="1" Text="Build a sentence ↗" Style="{StaticResource Secondary}" VerticalOptions="Center" Clicked="OnSentenceSection" />
                </Grid>
                <Border x:Name="ConnectionPanel" Style="{StaticResource Panel}" Padding="20,14">
                    <VerticalStackLayout Spacing="12">
                        <FlexLayout Wrap="Wrap">
                            <Button Text="Service connection ▾" Style="{StaticResource Secondary}" Clicked="OnConnectionToggle" Margin="0,0,8,8" />
                            <Button Text="Logs" Style="{StaticResource Secondary}" Clicked="OnOpenLogs" Margin="0,0,0,8" />
                        </FlexLayout>
                        <Label Text="Your access token stays in memory only" Style="{StaticResource Muted}" />
                        <Grid x:Name="ConnectionFields" ColumnDefinitions="*,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                            <VerticalStackLayout x:Name="AddressField" Spacing="7">
                                <Label Text="Service URL" />
                                <Entry x:Name="ServiceUrl" Placeholder="https://your-service/" Keyboard="Url" SemanticProperties.Description="Service URL" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="TokenField" Grid.Column="1" Spacing="7">
                                <Label Text="Access token" />
                                <Entry x:Name="AccessToken" IsPassword="True" IsTextPredictionEnabled="False" IsSpellCheckEnabled="False" SemanticProperties.Description="Access token" Completed="OnConnect" />
                            </VerticalStackLayout>
                            <Label x:Name="ConnectionHelp" Grid.Row="1" Grid.ColumnSpan="3" Text="Use the same service and access token as the website. Tokens are never saved on this device." Style="{StaticResource Muted}" />
                            <FlexLayout x:Name="LocalConnections" Grid.Row="2" Grid.ColumnSpan="3" Wrap="Wrap" IsVisible="False" />
                            <FlexLayout x:Name="ConnectionActions" Grid.Column="2" Wrap="Wrap" AlignItems="End">
                                <Button x:Name="ConnectButton" Text="Connect / refresh" Clicked="OnConnect" Margin="0,0,8,0" />
                                <Button Text="Disconnect" Style="{StaticResource Secondary}" Clicked="OnDisconnect" />
                            </FlexLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <ActivityIndicator x:Name="ProgressIndicator" IsVisible="False" IsRunning="False" Color="#2868B1" />
                <Border x:Name="Feedback" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="0">
                    <Label x:Name="StatusLabel" Text="Connect to load your collection." TextColor="#315C8C" LineBreakMode="WordWrap" />
                </Border>
                <Grid x:Name="Panels" ColumnDefinitions="1.7*,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="24">
                    <Border x:Name="WordPanel" Style="{StaticResource Panel}" VerticalOptions="Start" SizeChanged="OnWordPanelChanged">
                        <VerticalStackLayout Spacing="20">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                                <Label Grid.ColumnSpan="2" Text="YOUR PERSONAL WORD BANK" Style="{StaticResource Eyebrow}" />
                                <Label Grid.Row="1" Text="Word collection" Style="{StaticResource Heading}" SemanticProperties.HeadingLevel="Level2" />
                                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#E9EFF8" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="8,4" VerticalOptions="Center">
                                    <Label x:Name="WordCount" Text="0 on this page" FontSize="11" TextColor="#315C8C" />
                                </Border>
                            </Grid>
                            <Border BackgroundColor="#F8F9FA" Stroke="#E2E8F0" StrokeShape="RoundRectangle 10" Padding="16">
                                <Grid x:Name="WordForm" ColumnDefinitions="*,150,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                                    <VerticalStackLayout x:Name="WordField" Spacing="7">
                                        <Label x:Name="WordFieldLabel" Text="Add a word" />
                                        <Entry x:Name="WordInput" Placeholder="e.g. possibility" MaxLength="80" SemanticProperties.Description="Word" Completed="OnSaveWord" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout x:Name="TypeField" Grid.Column="1" Spacing="7">
                                        <Label Text="Word type" />
                                        <Picker x:Name="WordType" Title="Word type" SemanticProperties.Description="Word type" />
                                    </VerticalStackLayout>
                                    <Button x:Name="SaveWordButton" Grid.Column="2" Text="Add word" VerticalOptions="End" Clicked="OnSaveWord" IsEnabled="False" />
                                    <Button x:Name="CancelEditButton" Grid.Row="3" Grid.ColumnSpan="3" Text="Cancel edit" Style="{StaticResource Secondary}" IsVisible="False" Clicked="OnCancelEdit" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Spacing="8">
                                <Grid x:Name="FilterForm" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                                    <VerticalStackLayout Spacing="7">
                                        <Label Text="Search collection" />
                                        <Entry x:Name="SearchInput" Placeholder="Search by the start of a word…" MaxLength="80" SemanticProperties.Description="Search collection" Completed="OnSearch" />
                                    </VerticalStackLayout>
                                    <FlexLayout x:Name="FilterActions" Grid.Column="1" Wrap="Wrap" AlignItems="End">
                                        <Button x:Name="TypeFilterButton" Text="Word types · All ▾" Clicked="OnTypeToggle" Style="{StaticResource Secondary}" Margin="0,0,8,0" />
                                        <Button x:Name="ApplyFiltersButton" Text="Apply filters" Style="{StaticResource Secondary}" Clicked="OnSearch" IsEnabled="False" />
                                    </FlexLayout>
                                </Grid>
                                <Button x:Name="ClearFiltersButton" Text="Clear filters" Style="{StaticResource TextButton}" Clicked="OnClearFilters" HorizontalOptions="Start" IsEnabled="False" />
                                <Border x:Name="TypeFilterPanel" IsVisible="False" Stroke="#E2E8F0" StrokeShape="RoundRectangle 10" Padding="12">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="Word types" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Button Grid.Column="1" Text="Close" Style="{StaticResource Secondary}" Clicked="OnTypeToggle" />
                                        </Grid>
                                        <Label Text="Choose any types. None selected shows all words." Style="{StaticResource Muted}" />
                                        <VerticalStackLayout x:Name="TypeFilters" Spacing="4" />
                                        <Button Text="Clear type selection" Style="{StaticResource TextButton}" Clicked="OnClearTypes" />
                                        <Button x:Name="ApplyTypesButton" Text="Apply selected types" Clicked="OnSearch" IsEnabled="False" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="WORD &amp; TYPE" Style="{StaticResource Eyebrow}" />
                                <Label Grid.Column="1" Text="ACTIONS" Style="{StaticResource Eyebrow}" />
                            </Grid>
                            <VerticalStackLayout x:Name="WordRows" Spacing="0" />
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button x:Name="PreviousButton" Text="Previous" Style="{StaticResource Secondary}" IsEnabled="False" Clicked="OnPrevious" />
                                <Label x:Name="PageLabel" Grid.Column="1" Text="Page 1" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Button x:Name="NextButton" Grid.Column="2" Text="Next" Style="{StaticResource Secondary}" IsEnabled="False" Clicked="OnNext" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                    <Grid x:Name="SentenceColumn" Grid.Column="1" ColumnDefinitions="*,0" RowDefinitions="Auto,Auto" ColumnSpacing="0" RowSpacing="24" VerticalOptions="Start">
                        <Border x:Name="SentencePanel" Style="{StaticResource Panel}" VerticalOptions="Start">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="PUT YOUR WORDS TO WORK" Style="{StaticResource Eyebrow}" />
                                <Label Text="Build a sentence" Style="{StaticResource Heading}" SemanticProperties.HeadingLevel="Level2" />
                                <Label Text="Choose + Add to sentence beside a word. Use it again whenever you need it." Style="{StaticResource Muted}" />
                                <Label Text="Sentence preview" FontAttributes="Bold" FontSize="13" />
                                <Border BackgroundColor="#F8FAFC" Stroke="#CBD9EB" StrokeThickness="2" StrokeDashArray="3,2" StrokeShape="RoundRectangle 10" Padding="16" MinimumHeightRequest="110">
                                    <Label x:Name="SentencePreview" Text="Add words from your collection to see your sentence here." FontSize="19" TextColor="#253D5A" VerticalOptions="Center" LineBreakMode="CharacterWrap" />
                                </Border>
                                <ScrollView MaximumHeightRequest="320">
                                    <VerticalStackLayout x:Name="SentenceRows" Spacing="4" />
                                </ScrollView>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label x:Name="SentenceCount" Text="0 / 50 words" Style="{StaticResource Muted}" VerticalOptions="Center" />
                                    <Button x:Name="ClearSentenceButton" Grid.Column="1" Text="Clear" Style="{StaticResource TextButton}" Clicked="OnClearSentence" />
                                </Grid>
                                <Label x:Name="SentenceHelp" Text="Connect to your collection before saving a sentence." Style="{StaticResource Muted}" />
                                <Button x:Name="SaveSentenceButton" Text="Save sentence" IsEnabled="False" Clicked="OnSaveSentence" />
                                <Label Text="Saved sentences keep their wording when your collection changes." Style="{StaticResource Muted}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="HistoryPanel" Grid.Row="1" Style="{StaticResource Panel}" VerticalOptions="Start">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Saved sentences" Style="{StaticResource Heading}" VerticalOptions="Center" />
                                    <Button x:Name="RefreshHistoryButton" Grid.Column="1" Text="Refresh" Style="{StaticResource TextButton}" Clicked="OnHistoryFirst" />
                                </Grid>
                                <VerticalStackLayout x:Name="HistoryRows" Spacing="14">
                                    <Label Text="Your saved sentences will appear here." Style="{StaticResource Muted}" />
                                </VerticalStackLayout>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Button x:Name="HistoryFirstButton" Text="First" Style="{StaticResource Secondary}" IsEnabled="False" Clicked="OnHistoryFirst" />
                                    <Button x:Name="HistoryNextButton" Grid.Column="2" Text="Next" Style="{StaticResource Secondary}" IsEnabled="False" Clicked="OnHistoryNext" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Grid>
                <Label Text="One collection. Nine word types. Endless ways to express yourself." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" Margin="0,8" />
            </VerticalStackLayout>
        </ScrollView>
        <Border x:Name="SectionNavigation" Grid.Row="1" BackgroundColor="White" Stroke="#E2E8F0" Padding="10,6" IsVisible="False">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Text="Words" Style="{StaticResource Secondary}" Clicked="OnWordsSection" SemanticProperties.Description="Go to word collection" />
                <Button x:Name="SentenceShortcut" Grid.Column="1" Text="Sentence" Style="{StaticResource Secondary}" Clicked="OnSentenceSection" SemanticProperties.Description="Go to sentence builder" />
                <Button Grid.Column="2" Text="History" Style="{StaticResource Secondary}" Clicked="OnHistorySection" SemanticProperties.Description="Go to saved sentences" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
