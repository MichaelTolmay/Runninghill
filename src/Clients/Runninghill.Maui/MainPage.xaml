<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Runninghill.Maui.MainPage" Title="Runninghill">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" MaximumWidthRequest="640">
            <Label Text="Runninghill" Style="{StaticResource Headline}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Check that your application is ready to use." />
            <Button x:Name="CheckButton" Text="Check connection" Clicked="OnCheckClicked" />
            <ActivityIndicator x:Name="ProgressIndicator" IsVisible="False" IsRunning="False" />
            <Label x:Name="StatusLabel" Text="Ready to check the connection." />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
