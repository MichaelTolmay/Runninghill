<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:loc="clr-namespace:Runninghill.Maui" x:Class="Runninghill.Maui.MainPage" Title="{loc:Translate Key=Text_84147dd9ede0}" Shell.NavBarIsVisible="False" SafeAreaEdges="All" BackgroundColor="{DynamicResource ThemeBackground}" SizeChanged="OnLayoutChanged">
    <ContentPage.Resources>
        <!-- The same colors, spacing and type scale as the web design, using native controls. -->
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{DynamicResource ThemeText}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="{OnPlatform WinUI='Segoe UI', Default='OpenSansRegular'}" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{OnPlatform WinUI='Segoe UI', Default='OpenSansSemibold'}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="BackgroundColor" Value="{DynamicResource ThemeAccent}" />
            <Setter Property="TextColor" Value="{DynamicResource ThemeOnAccent}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,10" />
            <!-- Translated button captions may need more than one line. -->
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="MinimumHeightRequest" Value="{OnPlatform WinUI=44, Default=48}" />
            <Setter Property="MinimumWidthRequest" Value="{OnPlatform WinUI=44, Default=48}" />
            <!-- Keep disabled actions visibly different, just like the website. -->
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.48" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}" />
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSurface}" />
            <Setter Property="TextColor" Value="{DynamicResource ThemeSecondaryText}" />
            <Setter Property="BorderColor" Value="{DynamicResource ThemeSecondaryBorder}" />
            <Setter Property="BorderWidth" Value="1" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="FontFamily" Value="{OnPlatform WinUI='Segoe UI', Default='OpenSansRegular'}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSurface}" />
            <Setter Property="TextColor" Value="{DynamicResource ThemeText}" />
            <Setter Property="PlaceholderColor" Value="{DynamicResource ThemePlaceholder}" />
            <Setter Property="MinimumHeightRequest" Value="{OnPlatform WinUI=44, Default=48}" />
        </Style>
        <Style TargetType="Picker">
            <Setter Property="FontFamily" Value="{OnPlatform WinUI='Segoe UI', Default='OpenSansRegular'}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSurface}" />
            <Setter Property="TextColor" Value="{DynamicResource ThemeText}" />
            <Setter Property="MinimumHeightRequest" Value="{OnPlatform WinUI=44, Default=48}" />
        </Style>
        <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{DynamicResource ThemeAccentText}" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="BackgroundColor" Value="{DynamicResource ThemeDanger}" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSurface}" />
            <Setter Property="Stroke" Value="{DynamicResource ThemeLineBrush}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Padding" Value="24" />
        </Style>
        <Style x:Key="Heading" TargetType="Label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{DynamicResource ThemeHeading}" />
        </Style>
        <Style x:Key="Eyebrow" TargetType="Label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="CharacterSpacing" Value="1.6" />
            <Setter Property="TextColor" Value="{DynamicResource ThemeEyebrow}" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="Muted" TargetType="Label">
            <Setter Property="TextColor" Value="{DynamicResource ThemeMuted}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </ContentPage.Resources>
    <!-- Keep section shortcuts reachable even after scrolling through a full page of words. -->
    <Grid RowDefinitions="*,Auto">
        <ScrollView x:Name="PageScroll">
            <VerticalStackLayout x:Name="Workspace" Padding="40,24" Spacing="24" MaximumWidthRequest="1440" HorizontalOptions="Center">
                <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                    <Border BackgroundColor="{DynamicResource ThemeAccent}" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="44">
                        <Label Text="W" TextColor="{DynamicResource ThemeOnAccent}" FontSize="25" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Runninghill" FontSize="20" FontAttributes="Bold" />
                        <Label Text="{loc:Translate Key=Text_33cead23d9ac}" FontSize="10" CharacterSpacing="1.8" />
                    </VerticalStackLayout>
                    <Border Grid.Column="2" BackgroundColor="{DynamicResource ThemeBadgeBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="10,6" MaximumWidthRequest="125" VerticalOptions="Center">
                        <Label x:Name="ConnectionState" Text="{loc:Translate Key=Text_8b02f3de3906}" FontSize="12" TextColor="{DynamicResource ThemeBadgeText}" HorizontalTextAlignment="Center" />
                    </Border>
                </Grid>
                <Grid x:Name="AppearanceToolbar" ColumnDefinitions="*,Auto" ColumnSpacing="8" MaximumWidthRequest="560" HorizontalOptions="Center">
                    <loc:ThemeSelectors />
                    <Button Text="{loc:Translate Key=Text_126dd3b70a5c}" Style="{StaticResource Secondary}" Clicked="OnOpenLogs" Grid.Column="1" VerticalOptions="End" FontSize="12" Padding="8,10" MaximumWidthRequest="100" />
                </Grid>
                <loc:LanguagePicker x:Name="LanguageChoice" />
                <BoxView HeightRequest="1" Color="{DynamicResource ThemeLine}" />
                <Border x:Name="ThemeIcon" BackgroundColor="Transparent" StrokeThickness="0" Padding="0" WidthRequest="256" HeightRequest="128" MaximumWidthRequest="256" MaximumHeightRequest="128" HorizontalOptions="Start">
                    <Image Source="{DynamicResource ThemeIconSource}" Aspect="AspectFit" />
                </Border>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" Margin="0,8">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{loc:Translate Key=Text_6705b22afd2e}" Style="{StaticResource Eyebrow}" />
                        <Label x:Name="HeroTitle" Text="{loc:Translate Key=Text_459514301364}" FontSize="32" FontAttributes="Bold" TextColor="{DynamicResource ThemeHeading}" SemanticProperties.HeadingLevel="Level1" />
                        <Label Text="{loc:Translate Key=Text_b98e8f6a12ab}" Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                    <Button x:Name="IntroSentenceButton" Grid.Column="1" Text="{loc:Translate Key=Text_5b6b41489fae}" Style="{StaticResource Secondary}" VerticalOptions="Center" Clicked="OnSentenceSection" />
                </Grid>
                <Border x:Name="ConnectionPanel" Style="{StaticResource Panel}" Padding="20,14">
                    <VerticalStackLayout Spacing="12">
                        <FlexLayout Wrap="Wrap">
                            <Button Text="{loc:Translate Key=Text_91a0a5cdcde2}" Style="{StaticResource Secondary}" Clicked="OnConnectionToggle" Margin="0,0,8,8" />
                        </FlexLayout>
                        <Label Text="{loc:Translate Key=Text_559402bef2e7}" Style="{StaticResource Muted}" />
                        <Grid x:Name="ConnectionFields" ColumnDefinitions="*,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                            <VerticalStackLayout x:Name="AddressField" Spacing="7">
                                <Label Text="{loc:Translate Key=Text_077225837f3d}" />
                                <Entry x:Name="ServiceUrl" Placeholder="https://your-service/" Keyboard="Url" SemanticProperties.Description="{loc:Translate Key=Text_077225837f3d}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="TokenField" Grid.Column="1" Spacing="7">
                                <Label Text="{loc:Translate Key=Text_f69d5c7e6ea9}" />
                                <Entry x:Name="AccessToken" IsPassword="True" IsTextPredictionEnabled="False" IsSpellCheckEnabled="False" SemanticProperties.Description="{loc:Translate Key=Text_f69d5c7e6ea9}" Completed="OnConnect" />
                            </VerticalStackLayout>
                            <Label x:Name="ConnectionHelp" Grid.Row="1" Grid.ColumnSpan="3" Text="{loc:Translate Key=Text_9b969431f93f}" Style="{StaticResource Muted}" />
                            <FlexLayout x:Name="LocalConnections" Grid.Row="2" Grid.ColumnSpan="3" Wrap="Wrap" IsVisible="False" />
                            <FlexLayout x:Name="ConnectionActions" Grid.Column="2" Wrap="Wrap" AlignItems="End">
                                <Button x:Name="ConnectButton" Text="{loc:Translate Key=Text_2d7e570cac65}" Clicked="OnConnect" Margin="0,0,8,0" />
                                <Button Text="{loc:Translate Key=Text_ed28e0686e12}" Style="{StaticResource Secondary}" Clicked="OnDisconnect" />
                            </FlexLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <ActivityIndicator x:Name="ProgressIndicator" IsVisible="False" IsRunning="False" Color="{DynamicResource ThemeAccentText}" />
                <Border x:Name="Feedback" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="0">
                    <Label x:Name="StatusLabel" Text="{loc:Translate Key=Text_de34173811aa}" TextColor="{DynamicResource ThemeBadgeText}" LineBreakMode="WordWrap" />
                </Border>
                <Grid x:Name="Panels" ColumnDefinitions="1.7*,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="24">
                    <Border x:Name="WordPanel" Style="{StaticResource Panel}" VerticalOptions="Start" SizeChanged="OnWordPanelChanged">
                        <VerticalStackLayout Spacing="20">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                                <Label Grid.ColumnSpan="2" Text="{loc:Translate Key=Text_61829ca0ea6d}" Style="{StaticResource Eyebrow}" />
                                <Label Grid.Row="1" Text="{loc:Translate Key=Text_84147dd9ede0}" Style="{StaticResource Heading}" SemanticProperties.HeadingLevel="Level2" />
                                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{DynamicResource ThemeBadgeBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="8,4" VerticalOptions="Center">
                                    <Label x:Name="WordCount" Text="{loc:Translate Key=Text_0db35f78ade8}" FontSize="11" TextColor="{DynamicResource ThemeBadgeText}" />
                                </Border>
                            </Grid>
                            <Border BackgroundColor="{DynamicResource ThemeSurfaceAlt}" Stroke="{DynamicResource ThemeLineBrush}" StrokeShape="RoundRectangle 10" Padding="16">
                                <Grid x:Name="WordForm" ColumnDefinitions="*,150,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                                    <VerticalStackLayout x:Name="WordField" Spacing="7">
                                        <Label x:Name="WordFieldLabel" Text="{loc:Translate Key=Text_35c2eb2cb531}" />
                                        <Entry x:Name="WordInput" Placeholder="{loc:Translate Key=Text_d18eb90e230e}" MaxLength="80" SemanticProperties.Description="{loc:Translate Key=Text_44363ccb8230}" Completed="OnSaveWord" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout x:Name="TypeField" Grid.Column="1" Spacing="7">
                                        <Label Text="{loc:Translate Key=Text_f8fe9d54d138}" />
                                        <Picker x:Name="WordType" Title="{loc:Translate Key=Text_f8fe9d54d138}" SemanticProperties.Description="{loc:Translate Key=Text_f8fe9d54d138}" />
                                    </VerticalStackLayout>
                                    <Button x:Name="SaveWordButton" Grid.Column="2" Text="{loc:Translate Key=Text_b5daa8a90b4c}" VerticalOptions="End" Clicked="OnSaveWord" IsEnabled="False" />
                                    <Button x:Name="CancelEditButton" Grid.Row="3" Grid.ColumnSpan="3" Text="{loc:Translate Key=Text_b8f944abaa35}" Style="{StaticResource Secondary}" IsVisible="False" Clicked="OnCancelEdit" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Spacing="8">
                                <Grid x:Name="FilterForm" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                                    <VerticalStackLayout Spacing="7">
                                        <Label Text="{loc:Translate Key=Text_0ab6b4991a7e}" />
                                        <Entry x:Name="SearchInput" Placeholder="{loc:Translate Key=Text_cbdfd43e83fa}" MaxLength="80" SemanticProperties.Description="{loc:Translate Key=Text_0ab6b4991a7e}" Completed="OnSearch" />
                                    </VerticalStackLayout>
                                    <FlexLayout x:Name="FilterActions" Grid.Column="1" Wrap="Wrap" AlignItems="End">
                                        <Button x:Name="TypeFilterButton" Text="{loc:Translate Key=Text_72df03b458ad}" Clicked="OnTypeToggle" Style="{StaticResource Secondary}" Margin="0,0,8,0" />
                                        <Button x:Name="ApplyFiltersButton" Text="{loc:Translate Key=Text_926161d3e620}" Style="{StaticResource Secondary}" Clicked="OnSearch" IsEnabled="False" />
                                    </FlexLayout>
                                </Grid>
                                <Button x:Name="ClearFiltersButton" Text="{loc:Translate Key=Text_412226715c56}" Style="{StaticResource TextButton}" Clicked="OnClearFilters" HorizontalOptions="Start" IsEnabled="False" />
                                <Border x:Name="TypeFilterPanel" IsVisible="False" Stroke="{DynamicResource ThemeLineBrush}" StrokeShape="RoundRectangle 10" Padding="12">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{loc:Translate Key=Text_4728511f4e32}" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Button Grid.Column="1" Text="{loc:Translate Key=Text_bbfa773e5a63}" Style="{StaticResource Secondary}" Clicked="OnTypeToggle" />
                                        </Grid>
                                        <Label Text="{loc:Translate Key=Text_1e4ec09ff8df}" Style="{StaticResource Muted}" />
                                        <VerticalStackLayout x:Name="TypeFilters" Spacing="4" />
                                        <Button Text="{loc:Translate Key=Text_6dbc15d59481}" Style="{StaticResource TextButton}" Clicked="OnClearTypes" />
                                        <Button x:Name="ApplyTypesButton" Text="{loc:Translate Key=Text_c1eaee2e22c9}" Clicked="OnSearch" IsEnabled="False" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{loc:Translate Key=Text_413ffea05e7e}" Style="{StaticResource Eyebrow}" />
                                <Label Grid.Column="1" Text="{loc:Translate Key=Text_bbb86bcb941f}" Style="{StaticResource Eyebrow}" />
                            </Grid>
                            <VerticalStackLayout x:Name="WordRows" Spacing="0" />
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button x:Name="PreviousButton" Text="{loc:Translate Key=Text_50f94286ba30}" Style="{StaticResource Secondary}" IsEnabled="False" Clicked="OnPrevious" />
                                <Label x:Name="PageLabel" Grid.Column="1" Text="{loc:Translate Key=Text_0cd2664cb285}" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Button x:Name="NextButton" Grid.Column="2" Text="{loc:Translate Key=Text_bc981983e7f5}" Style="{StaticResource Secondary}" IsEnabled="False" Clicked="OnNext" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                    <Grid x:Name="SentenceColumn" Grid.Column="1" ColumnDefinitions="*,0" RowDefinitions="Auto,Auto" ColumnSpacing="0" RowSpacing="24" VerticalOptions="Start">
                        <Border x:Name="SentencePanel" Style="{StaticResource Panel}" VerticalOptions="Start">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="{loc:Translate Key=Text_c9a1d9770973}" Style="{StaticResource Eyebrow}" />
                                <Label Text="{loc:Translate Key=Text_dd770e03d7ab}" Style="{StaticResource Heading}" SemanticProperties.HeadingLevel="Level2" />
                                <Label Text="{loc:Translate Key=Text_a7793f1832a1}" Style="{StaticResource Muted}" />
                                <Label Text="{loc:Translate Key=Text_2afd6b5863a9}" FontAttributes="Bold" FontSize="13" />
                                <Border BackgroundColor="{DynamicResource ThemePreviewBackground}" Stroke="{DynamicResource ThemePreviewBorderBrush}" StrokeThickness="2" StrokeDashArray="3,2" StrokeShape="RoundRectangle 10" Padding="16" MinimumHeightRequest="110">
                                    <Label x:Name="SentencePreview" Text="{loc:Translate Key=Text_53156e1192f4}" FontSize="19" TextColor="{DynamicResource ThemePreviewText}" VerticalOptions="Center" LineBreakMode="CharacterWrap" />
                                </Border>
                                <ScrollView MaximumHeightRequest="320">
                                    <VerticalStackLayout x:Name="SentenceRows" Spacing="4" />
                                </ScrollView>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label x:Name="SentenceCount" Text="{loc:Translate Key=Text_8935d2851aad}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                                    <Button x:Name="ClearSentenceButton" Grid.Column="1" Text="{loc:Translate Key=Text_719ea396ad92}" Style="{StaticResource TextButton}" Clicked="OnClearSentence" />
                                </Grid>
                                <Label x:Name="SentenceHelp" Text="{loc:Translate Key=Text_ab8cace3373a}" Style="{StaticResource Muted}" />
                                <Button x:Name="SaveSentenceButton" Text="{loc:Translate Key=Text_6600f0c494a1}" IsEnabled="False" Clicked="OnSaveSentence" />
                                <Label Text="{loc:Translate Key=Text_1d433a86996b}" Style="{StaticResource Muted}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="HistoryPanel" Grid.Row="1" Style="{StaticResource Panel}" VerticalOptions="Start">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{loc:Translate Key=Text_3a98f2af4006}" Style="{StaticResource Heading}" VerticalOptions="Center" />
                                    <Button x:Name="RefreshHistoryButton" Grid.Column="1" Text="{loc:Translate Key=Text_56e3badc4e6c}" Style="{StaticResource TextButton}" Clicked="OnHistoryFirst" />
                                </Grid>
                                <VerticalStackLayout x:Name="HistoryRows" Spacing="14">
                                    <Label Text="{loc:Translate Key=Text_4441235c0693}" Style="{StaticResource Muted}" />
                                </VerticalStackLayout>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Button x:Name="HistoryFirstButton" Text="{loc:Translate Key=Text_916a78d701de}" Style="{StaticResource Secondary}" IsEnabled="False" Clicked="OnHistoryFirst" />
                                    <Button x:Name="HistoryNextButton" Grid.Column="2" Text="{loc:Translate Key=Text_bc981983e7f5}" Style="{StaticResource Secondary}" IsEnabled="False" Clicked="OnHistoryNext" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Grid>
                <Label Text="{loc:Translate Key=Text_f7a3bdec827f}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" Margin="0,8" />
            </VerticalStackLayout>
        </ScrollView>
        <Border x:Name="SectionNavigation" Grid.Row="1" BackgroundColor="{DynamicResource ThemeSurface}" Stroke="{DynamicResource ThemeLineBrush}" Padding="10,6" IsVisible="False">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Text="{loc:Translate Key=Text_d26d55c7f815}" Style="{StaticResource Secondary}" Clicked="OnWordsSection" SemanticProperties.Description="{loc:Translate Key=Text_70e6d0eca92c}" />
                <Button x:Name="SentenceShortcut" Grid.Column="1" Text="{loc:Translate Key=Text_1bb1f30ec48f}" Style="{StaticResource Secondary}" Clicked="OnSentenceSection" SemanticProperties.Description="{loc:Translate Key=Text_63c5b4d0ad73}" />
                <Button Grid.Column="2" Text="{loc:Translate Key=Text_90ccd6497400}" Style="{StaticResource Secondary}" Clicked="OnHistorySection" SemanticProperties.Description="{loc:Translate Key=Text_a0c15efce128}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
