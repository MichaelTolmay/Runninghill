@page "/"
@using Runninghill.Clients
@implements IDisposable

@if (showLogs)
{
    <Logs InitialToken="@token" OnClose="CloseLogs" />
}
else
{
<PageTitle>@T("Word collection · Runninghill")</PageTitle>
<a class="skip-link" href="#collection">@T("Skip to word collection")</a>
<div class="workspace">
    <header class="topbar">
        <a class="brand" href="/" aria-label="@T("Runninghill home")"><span class="brand-mark">W</span><span>Runninghill<small>@T("WORD COLLECTION")</small></span></a>
        <div class="appearance-toolbar"><ThemeSelectors ThemeChanged="@(id => activeTheme = id)" /><button class="secondary" @onclick="OpenLogs" disabled="@busy">@T("Logs")</button></div>
        <LanguageSelector Disabled="@busy" />
        <span class="connection-badge">@(connected ? T("Connected") : T("Connect to get started"))</span>
    </header>
    <main>
        <div class="theme-icon" data-icon="@AppThemes.IconId(activeTheme)" style="--theme-icon-image:url('@AppThemes.IconDataUri(activeTheme)')"><img src="@AppThemes.IconDataUri(activeTheme)" data-icon="@AppThemes.IconId(activeTheme)" alt="" width="256" height="128" /></div>
        <section class="intro">
            <div><p class="eyebrow">@T("A LITTLE LANGUAGE, A LOT OF POSSIBILITY")</p><h1>@T("Your words. New possibilities.")</h1><p>@T("Collect words by type, then bring them together in a sentence.")</p></div>
            <a class="button secondary" href="#sentence">@T("Build a sentence") <span aria-hidden="true">↗</span></a>
        </section>
        <details class="connection panel" open="@(!connected)">
            <summary>@T("Service connection") <span class="muted">@T("Your access token stays in memory only")</span></summary>
            <form @onsubmit="ConnectAsync" @onsubmit:preventDefault class="connection-form" novalidate>
                <div class="field"><label for="token">@T("Access token")</label><input id="token" disabled="@busy" type="password" @bind="token" autocomplete="off" spellcheck="false" required /></div>
                <button disabled="@busy">@(busy ? T("Please wait…") : T("Connect / refresh"))</button>
                @if (connected) { <button type="button" class="secondary" @onclick="Disconnect" disabled="@busy">@T("Disconnect")</button> }
            </form>
        </details>
        <p class="feedback @(error ? "error" : "")" role="status" aria-live="polite">@message</p>
        <div class="workspace-grid" aria-busy="@busy">
            <section id="collection" class="panel collection" aria-labelledby="collection-title">
                <div class="section-heading"><div><p class="eyebrow">@T("YOUR PERSONAL WORD BANK")</p><h2 id="collection-title">@T("Word collection")</h2></div><span class="count">@F($"{words.Length} on this page")</span></div>
                <form class="word-form" @onsubmit="SaveWordAsync" @onsubmit:preventDefault novalidate>
                    <div class="field word-field"><label for="word">@(editingId is null ? T("Add a word") : T("Edit word"))</label><input id="word" disabled="@busy" @ref="wordInput" @bind="draftWord" maxlength="80" placeholder="@T("e.g. possibility")" required autocomplete="off" /></div>
                    <div class="field"><label for="word-type">@T("Word type")</label><select id="word-type" disabled="@busy" @bind="draftType">@foreach (var type in WordTypes.All) { <option value="@type">@T(type)</option> }</select></div>
                    <button disabled="@(!connected || busy)">@(editingId is null ? T("Add word") : T("Save changes"))</button>
                    @if (editingId is not null) { <button type="button" class="secondary" @onclick="CancelEdit" disabled="@busy">@T("Cancel edit")</button> }
                </form>
                <form class="filters" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                    <div class="field search-field"><label for="search">@T("Search collection")</label><input id="search" disabled="@busy" @bind="search" maxlength="80" placeholder="@T("Search by the start of a word…")" type="search" /></div>
                    <details class="type-filter" data-dismiss-dropdown><summary>@T("Word types") <span class="count">@(selectedTypes.Count == 0 ? T("All") : selectedTypes.Count)</span></summary>
                        <div class="type-options">
                            <div class="dropdown-heading"><strong>@T("Filter by word type")</strong><button type="button" class="text-button" data-close-dropdown aria-label="@T("Close word types")">@T("Close")</button></div>
                            <p class="muted">@T("Choose types, then apply filters.")</p>
                            @foreach (var type in WordTypes.All) { <label><input type="checkbox" disabled="@busy" checked="@selectedTypes.Contains(type)" @onchange="() => ToggleType(type)" /> @T(type)</label> }
                            <button type="button" class="text-button" disabled="@busy" @onclick="ClearTypes">@T("Clear type selection")</button>
                            <button type="submit" class="full-width" disabled="@(!connected || busy)">@T("Apply selected types")</button>
                        </div>
                    </details>
                    <button class="secondary" disabled="@(!connected || busy)">@T("Apply filters")</button>
                    <button type="button" class="text-button" disabled="@(!connected || busy)" @onclick="ResetFiltersAsync">@T("Clear filters")</button>
                </form>
                @if (words.Length == 0)
                {
                    <div class="empty"><span class="empty-icon" aria-hidden="true">Aa</span><h3>@(connected ? T("Make room for a new word") : T("Your collection starts here"))</h3><p>@(connected ? T("Add your first word above, or try a different search or word type.") : T("Enter an access token and connect to load your saved words."))</p></div>
                }
                else
                {
                    <div class="list-heading"><span>@T("WORD & TYPE")</span><span>@T("ACTIONS")</span></div>
                    <ul class="word-list">
                        @foreach (var word in words)
                        {
                            <li @key="word.Id"><div class="word-description"><strong>@word.Word</strong><span class="tag @TypeClass(word.Type)">@T(word.Type)</span></div>
                                <div class="row-actions"><button class="secondary" @onclick="() => AddToSentence(word)" disabled="@(busy || chosen.Count >= 50)" aria-label="@F($"Add {word.Word} to sentence")">@T("+ Add to sentence")</button><button class="text-button" @onclick="() => EditAsync(word)" disabled="@busy" aria-label="@F($"Edit {word.Word}")">@T("Edit")</button><button class="text-button danger" @onclick="() => ConfirmDelete(word.Id)" disabled="@busy" aria-label="@F($"Delete {word.Word}")">@T("Delete")</button></div>
                                @if (pendingDelete == word.Id)
                                {
                                    <div class="delete-confirm" role="group" aria-label="@T("Confirm deletion")"><p>@F($"Delete “{word.Word}”? Saved sentences will stay unchanged.")</p><button class="danger-button" disabled="@busy" @onclick="() => DeleteAsync(word)">@T("Confirm delete")</button><button class="secondary" disabled="@busy" @onclick="() => ConfirmDelete(null)">@T("Keep word")</button></div>
                                }
                            </li>
                        }
                    </ul>
                }
                <div class="pagination"><button class="secondary" disabled="@(busy || previous.Count == 0)" @onclick="PreviousAsync">@T("Previous")</button><span>@F($"Page {previous.Count + 1}")</span><button class="secondary" disabled="@(busy || nextAfter is null)" @onclick="NextAsync">@T("Next")</button></div>
            </section>
            <aside class="sentence-column">
                <section id="sentence" class="panel" aria-labelledby="sentence-title">
                    <p class="eyebrow">@T("PUT YOUR WORDS TO WORK")</p><h2 id="sentence-title">@T("Build a sentence")</h2><p class="muted">@T("Choose + Add to sentence beside a word. Use it again whenever you need it.")</p>
                    <p class="preview-label">@T("Sentence preview")</p>
                    <div class="sentence-preview">
                        @if (chosen.Count == 0) { <p class="placeholder">@T("Add words from your collection to see your sentence here.")</p> }
                        else { <p class="sentence-text">@string.Join(" ", chosen.Select(w => w.Word))</p> }
                    </div>
                    <ol class="sentence-words">
                        @for (var i = 0; i < chosen.Count; i++)
                        {
                            var index = i;
                            <li><span class="tag @TypeClass(chosen[i].Type)">@(i + 1). @chosen[i].Word</span><div class="chip-actions"><button class="text-button" aria-label="@F($"Move word {i + 1} earlier")" disabled="@(busy || i == 0)" @onclick="() => Move(index, -1)">←</button><button class="text-button" aria-label="@F($"Move word {i + 1} later")" disabled="@(busy || i == chosen.Count - 1)" @onclick="() => Move(index, 1)">→</button><button class="text-button" aria-label="@F($"Remove word {i + 1}")" disabled="@busy" @onclick="() => Remove(index)">×</button></div></li>
                        }
                    </ol>
                    <div class="sentence-footer"><span class="muted">@F($"{chosen.Count} / 50 words")</span><button class="text-button" disabled="@(busy || chosen.Count == 0)" @onclick="ClearSentence">@T("Clear")</button></div>
                    <p id="sentence-help" class="hint" aria-live="polite">@SentenceHelp</p>
                    <button class="full-width" aria-describedby="sentence-help" disabled="@(!connected || busy || chosen.Count == 0)" @onclick="SaveSentenceAsync">@T("Save sentence")</button>
                    <p class="hint">@T("Saved sentences keep their wording when your collection changes.")</p>
                </section>
                <section class="panel history" aria-labelledby="history-title"><div class="section-heading"><h2 id="history-title">@T("Saved sentences")</h2><button class="text-button" disabled="@(!connected || busy)" @onclick="RefreshHistoryAsync">@T("Refresh")</button></div>
                    @if (sentences.Length == 0) { <p class="muted">@T("Your saved sentences will appear here.")</p> }
                    <ol>@foreach (var sentence in sentences) { <li @key="sentence.Id"><p>@sentence.Text</p><small>@sentence.CreatedAt.ToLocalTime().ToString("dd MMM yyyy · HH:mm", AppText.Culture)</small></li> }</ol>
                    <div class="pagination"><button class="secondary" disabled="@(busy || sentenceAfter == 0)" @onclick="RefreshHistoryAsync">@T("First")</button><button class="secondary" disabled="@(busy || nextSentenceAfter is null)" @onclick="NextHistoryAsync">@T("Next")</button></div>
                </section>
            </aside>
        </div>
        <footer>@T("One collection. Nine word types. Endless ways to express yourself.")</footer>
    </main>
</div>

}
