<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <!-- Favour runtime speed over download size; retain all runtime safety checks. -->
    <EmccCompileOptimizationFlag Condition="'$(Configuration)' == 'Release'">-O3</EmccCompileOptimizationFlag>
    <WasmBitcodeCompileOptimizationFlag Condition="'$(Configuration)' == 'Release'">-O3</WasmBitcodeCompileOptimizationFlag>
    <EmccLinkOptimizationFlag Condition="'$(Configuration)' == 'Release'">-O3</EmccLinkOptimizationFlag>
    <IsAotCompatible>true</IsAotCompatible>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <!-- Content-based filenames prevent an older cached script from being used with a new assembly. -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>
  <ItemGroup>
    <!-- Router discovers pages by reflection; preserve page types through full trimming. -->
    <Content Update="wwwroot/appsettings.Development.json" CopyToPublishDirectory="Never" />
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
    <ProjectReference Include="../../Runninghill.Contracts/Runninghill.Contracts.csproj" />
    <!-- Share error descriptions, without adding a request wrapper or another assembly. -->
    <Compile Include="../Shared/ClientMessages.cs" Link="ClientMessages.cs" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Shared/OperationLog.cs" Link="OperationLog.cs" />
  </ItemGroup>
  <ItemGroup><Compile Include="../../Shared/RecentLogStore.cs" Link="RecentLogStore.cs" /></ItemGroup>
  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="AppScript" Pattern="*.js" Expression="#[.{fingerprint}]!" />
    <!-- CSS uses stable filenames and nginx revalidation; the HTML placeholder pipeline fingerprints scripts only. -->
    <Compile Include="../Shared/AppThemes.cs" Link="AppThemes.cs" />
    <EmbeddedResource Include="../../../themes/*.json" LogicalName="Runninghill.Themes.%(Filename).json" />
    <EmbeddedResource Include="../../../themes/*_icon.webp" LogicalName="Runninghill.Themes.%(Filename).webp" />
  </ItemGroup>
</Project>
