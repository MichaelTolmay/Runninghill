<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <!-- Real words need Unicode normalization; invariant mode silently skips it. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- Debug credentials are read from the source working directory, never shipped. -->
    <Content Update="appsettings.Development.local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <ProjectReference Include="../Runninghill.Application/Runninghill.Application.csproj" />
    <ProjectReference Include="../Runninghill.Database/Runninghill.Database.csproj" />
    <ProjectReference Include="../Runninghill.Contracts/Runninghill.Contracts.csproj" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <Protobuf Include="Protos/application.proto" GrpcServices="Server" />
  </ItemGroup>
</Project>
